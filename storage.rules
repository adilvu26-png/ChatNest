rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function img() { return request.resource.contentType.matches('image/.*'); }
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && request.resource.size < 3 * 1024 * 1024 && img();
    }
    match /statuses/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && img();
    }
    match /groups/{chatId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.admins
        && request.resource.size < 3 * 1024 * 1024 && img();
    }
    match /chats/{chatId}/{file} {
      allow read: if request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
      allow write: if request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
